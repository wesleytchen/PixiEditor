// Glitch & Signal — selectable ASCII Magic-inspired family for PixiEditor
// Effect is an integer selector. Amount: -1=bypass, 0=default, 1=strong.
uniform shader iImage;
uniform float2 iResolution;
uniform float iNormalizedTime;
uniform int Effect;
uniform float Amount;
uniform float Scale;
uniform float Seed;

float sat(float x) { return clamp(x, 0.0, 1.0); }
float hash21(float2 p) {
    p = fract(p * float2(123.34, 456.21));
    p += dot(p, p + 45.32 + Seed);
    return fract(p.x * p.y);
}
float lum(half3 c) { return dot(c, half3(0.2126, 0.7152, 0.0722)); }
half4 sampleImage(float2 p) { return iImage.eval(p); }
half4 finish(half3 rgb, half a) { return half4(clamp(rgb, half3(0.0), half3(1.0)) * a, a); }
half3 straight(half4 c) { return c.a > 0.0001 ? c.rgb / c.a : half3(0.0); }

// Effect values:
//   0: CRT Screen
//   1: Pixel Sort
//   2: Forensics
//   3: Digital Distortion
//   4: Datamosh
//   5: Lofi
//   6: RGB Split
//   7: Scanline
//   8: Thermal
//   9: Beacon
half3 heat(float t) { return clamp(half3(1.5*t,1.5-abs(2.5*t-1.2),1.6-2.0*t),half3(0.0),half3(1.0)); }
half4 main(float2 xy) {
    int EFFECT = Effect + 0;
    float strength=sat(1.0+Amount); float sc=exp2(Scale); half4 src=sampleImage(xy); half3 rgb=straight(src); half3 fx=rgb;
    float line=floor(xy.y/(3.0*sc)); float n=hash21(float2(line,floor(iNormalizedTime*24.0)));
    if (EFFECT==0) { float2 p=(xy/iResolution)*2.0-1.0; float2 uv=(p*(1.0+.08*dot(p,p))*.5+.5)*iResolution; half3 c=straight(sampleImage(uv)); c*=half(.78+.22*sin(xy.y*3.14159)); fx=c*half3(1.04,1.0,.94); }
    else if (EFFECT==1) { float shift=(n-.5)*80.0*step(.72,n); fx=straight(sampleImage(float2(xy.x+shift,xy.y))); fx=floor(fx*half(10.0))/half(10.0); }
    else if (EFFECT==2) { half3 gx=straight(sampleImage(xy+float2(2,0)))-straight(sampleImage(xy-float2(2,0))); float e=abs(float(lum(gx))); fx=half3(e*3.0,float(lum(rgb)),1.0-e); }
    else if (EFFECT==3) { float2 uv=xy; uv.x+=(n-.5)*55.0*step(.62,n); uv.y+=sin(xy.x*.08+Seed)*4.0; fx=straight(sampleImage(uv)); }
    else if (EFFECT==4) { float block=max(6.0,28.0*sc); float2 id=floor(xy/block); float2 uv=xy+float2((hash21(id)-.5)*block*2.0,0); fx=straight(sampleImage(uv)); }
    else if (EFFECT==5) { fx=floor(rgb*half(7.0))/half(7.0); fx*=half(.82+.18*hash21(floor(xy/4.0))); }
    else if (EFFECT==6) { float d=5.0+10.0*strength; fx=half3(straight(sampleImage(xy+float2(d,0))).r,rgb.g,straight(sampleImage(xy-float2(d,0))).b); }
    else if (EFFECT==7) { fx=rgb*half(.72+.28*step(.55,fract(xy.y/(3.0*sc)))); }
    else if (EFFECT==8) fx=heat(float(lum(rgb)));
    else { float2 p=xy-iResolution*.5; float a=atan(p.y,p.x); float beam=pow(max(0.0,cos(a*8.0+Seed)),18.0); fx=rgb+half3(.1,.65,1.0)*half(beam*.8); }
    return finish(mix(rgb,fx,half(strength)),src.a);
}
