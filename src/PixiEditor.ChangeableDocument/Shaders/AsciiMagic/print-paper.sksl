// Print & Paper — selectable ASCII Magic-inspired family for PixiEditor
// Effect is an integer selector. Amount: -1=bypass, 0=default, 1=strong.
uniform shader iImage;
uniform float2 iResolution;
uniform float iNormalizedTime;
uniform int Effect;
uniform float Amount;
uniform float Scale;
uniform float Seed;
uniform float Opacity;
uniform int Palette;
uniform int Chroma;
uniform float Brightness;
uniform float Contrast;
uniform int InvertColors;

float sat(float x) { return clamp(x, 0.0, 1.0); }
float hash21(float2 p) {
    p = fract(p * float2(123.34, 456.21));
    p += dot(p, p + 45.32 + Seed);
    return fract(p.x * p.y);
}
float lum(half3 c) { return dot(c, half3(0.2126, 0.7152, 0.0722)); }
half4 sampleImage(float2 p) { return iImage.eval(p); }
half3 applyFinishing(half3 rgb) {
    rgb = clamp((rgb - half3(0.5)) * half(1.0 + Contrast) + half3(0.5 + Brightness),
                half3(0.0), half3(1.0));
    float l = float(lum(rgb));

    if (Chroma == 1) rgb = half3(l);
    else if (Chroma == 2) rgb = floor(rgb * half(7.0) + half(0.5)) / half(7.0);

    if (Palette == 1) {
        rgb = half3(step(0.5, l));
    } else if (Palette == 2) {
        rgb = half3(floor(l * 3.0 + 0.5) / 3.0);
    } else if (Palette == 3) {
        rgb = half3(floor(l * 7.0 + 0.5) / 7.0);
    } else if (Palette == 4) {
        rgb = l < 0.25 ? half3(0.06, 0.22, 0.06) :
              (l < 0.5 ? half3(0.19, 0.38, 0.19) :
              (l < 0.75 ? half3(0.55, 0.67, 0.32) : half3(0.79, 0.85, 0.49)));
    } else if (Palette == 5) {
        rgb = l < 0.33 ? half3(0.0, 0.0, 0.0) :
              (l < 0.66 ? half3(0.0, 0.78, 0.78) : half3(0.78, 0.0, 0.78));
    } else if (Palette == 6) {
        rgb = l < 0.33 ? half3(0.0, 0.0, 0.0) :
              (l < 0.66 ? half3(0.78, 0.0, 0.0) : half3(0.78, 0.78, 0.0));
    } else if (Palette == 7) {
        rgb = floor(rgb * half(3.0) + half(0.5)) / half(3.0);
    } else if (Palette == 8) {
        rgb = mix(half3(0.04, 0.02, 0.18), half3(1.0, 0.05, 0.72), half(l));
        rgb = mix(rgb, half3(0.0, 0.95, 1.0), half(smoothstep(0.62, 1.0, l)));
    } else if (Palette == 9) {
        rgb = mix(half3(0.90, 0.72, 0.82), half3(0.70, 0.88, 0.91), half(l));
        rgb = mix(rgb, half3(1.0, 0.91, 0.68), half(smoothstep(0.66, 1.0, l)));
    } else if (Palette == 10) {
        rgb = l < 0.38 ? half3(0.10, 0.18, 0.28) :
              (l < 0.70 ? half3(0.90, 0.22, 0.20) : half3(0.96, 0.86, 0.64));
    } else if (Palette == 11) {
        rgb = half3(dot(rgb, half3(0.393, 0.769, 0.189)),
                    dot(rgb, half3(0.349, 0.686, 0.168)),
                    dot(rgb, half3(0.272, 0.534, 0.131)));
    }

    if (InvertColors != 0) rgb = half3(1.0) - rgb;
    return clamp(rgb, half3(0.0), half3(1.0));
}
half4 finish(half3 rgb, half a) {
    half alpha = a * half(Opacity);
    return half4(applyFinishing(rgb) * alpha, alpha);
}
half3 straight(half4 c) { return c.a > 0.0001 ? c.rgb / c.a : half3(0.0); }

// Effect values:
//   0: Dither
//   1: Stippling
//   2: Risograph
//   3: Comic
//   4: Sketch
//   5: Engraving
//   6: Warhol
//   7: Blueprint
//   8: Halftone
//   9: Woodblock
//   10: Posterize
//   11: Mezzotint
//   12: Pointillize
//   13: Crosshatch
//   14: CMYK Drops
//   15: Cyanotype
//   16: Honeycomb Screen
//   17: Crumpled Print
float bayer4(float2 p) {
    float2 m = mod(floor(p), 4.0);
    return fract((m.x * 0.5 + m.y * 0.75 + m.x * m.y * 0.25) * 0.25);
}
half3 palette(float t, half3 a, half3 b, half3 c) {
    return t < 0.33 ? a : (t < 0.66 ? b : c);
}
half4 main(float2 xy) {
    int EFFECT = Effect + 0;
    float strength = sat(1.0 + Amount);
    float s = max(2.0, 6.0 * exp2(Scale));
    half4 src = sampleImage(xy);
    half3 rgb = straight(src);
    float l = float(lum(rgb));
    float2 p = xy / s;
    float2 q = fract(p) - 0.5;
    float n = hash21(floor(p));
    half3 fx = rgb;
    if (EFFECT == 0) {
        float v = step(bayer4(p), l); fx = half3(v);
    } else if (EFFECT == 1 || EFFECT == 11 || EFFECT == 12) {
        float r = 0.08 + 0.43 * (1.0 - l);
        float d = 1.0 - smoothstep(r, r + 0.08, length(q + (n - 0.5) * 0.25));
        fx = EFFECT == 12 ? mix(half3(0.96,0.90,0.78), rgb, half(d)) : half3(1.0 - d);
    } else if (EFFECT == 2) {
        float red = step(hash21(floor(p) + 1.0), float(rgb.r));
        float blue = step(hash21(floor(p) + 9.0), float(rgb.b));
        fx = half3(0.94,0.87,0.70) - half3(0.05,0.55,0.60)*half(red) - half3(0.65,0.25,0.02)*half(blue);
    } else if (EFFECT == 3 || EFFECT == 8) {
        float ang = (EFFECT == 3 ? 0.35 : 0.0);
        float2 rxy = float2(cos(ang)*q.x-sin(ang)*q.y, sin(ang)*q.x+cos(ang)*q.y);
        float d = 1.0 - smoothstep(0.08 + 0.40*(1.0-l), 0.14 + 0.40*(1.0-l), length(rxy));
        fx = mix(half3(1.0), half3(0.02), half(d));
        if (EFFECT == 3) fx = mix(fx, rgb, half(0.28));
    } else if (EFFECT == 4) {
        half3 gx = straight(sampleImage(xy + float2(1.5,0))) - straight(sampleImage(xy - float2(1.5,0)));
        half3 gy = straight(sampleImage(xy + float2(0,1.5))) - straight(sampleImage(xy - float2(0,1.5)));
        float e = length(float2(float(lum(gx)), float(lum(gy)))); fx = half3(1.0 - sat(e*4.5));
    } else if (EFFECT == 5 || EFFECT == 13) {
        float a = EFFECT == 5 ? 0.0 : 0.785;
        float line1 = step(0.42, abs(sin((xy.x*cos(a)+xy.y*sin(a))*0.9)));
        float line2 = step(0.55, abs(sin((xy.x*cos(-a)+xy.y*sin(-a))*0.75)));
        float ink = step(l, 0.65) * line1 + step(l, 0.35) * line2;
        fx = half3(1.0 - sat(ink));
    } else if (EFFECT == 6) {
        half3 c1 = half3(0.93,0.15,0.36), c2 = half3(0.10,0.70,0.85), c3 = half3(0.96,0.82,0.12);
        fx = palette(fract(l*3.0 + floor(p.x/18.0)*0.21), c1, c2, c3);
    } else if (EFFECT == 7 || EFFECT == 15) {
        float grid = 1.0 - smoothstep(0.04,0.10,min(fract(p.x),fract(p.y)));
        half3 paper = EFFECT == 7 ? half3(0.04,0.16,0.31) : half3(0.05,0.23,0.28);
        fx = paper + half3(0.12,0.52,0.66)*half(l) + half3(grid*0.08);
    } else if (EFFECT == 9) {
        float grain = n*0.18; fx = half3(step(0.42+grain,l))*half3(0.60,0.12,0.05) + half3(0.30,0.14,0.04);
    } else if (EFFECT == 10) {
        fx = floor(rgb * half(4.0) + half(0.5)) / half(4.0);
    } else if (EFFECT == 14) {
        float dc = 1.0-smoothstep(0.16+0.28*(1.0-float(rgb.r)),0.24+0.28*(1.0-float(rgb.r)),length(q+float2(-.12,0)));
        float dm = 1.0-smoothstep(0.16+0.28*(1.0-float(rgb.g)),0.24+0.28*(1.0-float(rgb.g)),length(q+float2(.12,0)));
        float dy = 1.0-smoothstep(0.16+0.28*(1.0-float(rgb.b)),0.24+0.28*(1.0-float(rgb.b)),length(q+float2(0,.12)));
        fx = half3(1.0-dc*0.85,1.0-dm*0.78,1.0-dy*0.82);
    } else if (EFFECT == 16) {
        float2 hq=q; hq.x*=1.15; float h=max(abs(hq.x)*.866+abs(hq.y)*.5,abs(hq.y));
        fx = mix(half3(.96), half3(l), half(1.0-smoothstep(.35,.46,h)));
    } else {
        float wrinkle = sin(xy.x*.035+sin(xy.y*.021))*sin(xy.y*.041+n*2.0);
        fx = rgb*half(.86+.12*wrinkle)+half3(.08,.06,.035);
    }
    return finish(mix(rgb, fx, half(strength)), src.a);
}
