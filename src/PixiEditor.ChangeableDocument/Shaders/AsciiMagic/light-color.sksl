// Light & Color — selectable ASCII Magic-inspired family for PixiEditor
// Effect is an integer selector. Amount: -1=bypass, 0=default, 1=strong.
uniform shader iImage;
uniform float2 iResolution;
uniform float iNormalizedTime;
uniform int Effect;
uniform float Amount;
uniform float Scale;
uniform float Seed;

float sat(float x) { return clamp(x, 0.0, 1.0); }
float hash21(float2 p) {
    p = fract(p * float2(123.34, 456.21));
    p += dot(p, p + 45.32 + Seed);
    return fract(p.x * p.y);
}
float lum(half3 c) { return dot(c, half3(0.2126, 0.7152, 0.0722)); }
half4 sampleImage(float2 p) { return iImage.eval(p); }
half4 finish(half3 rgb, half a) { return half4(clamp(rgb, half3(0.0), half3(1.0)) * a, a); }
half3 straight(half4 c) { return c.a > 0.0001 ? c.rgb / c.a : half3(0.0); }

// Effect values:
//   0: Disco
//   1: Anaglyph 3D
//   2: Gradient Map
//   3: Prism
//   4: Dreamdust
//   5: Light Wind
//   6: Kaleidoscope
//   7: Warpbloom
//   8: Duotone
//   9: Edge Glow
//   10: Aberration
half3 ramp(float t) { return half3(.5+.5*cos(6.283*(t+.0)),.5+.5*cos(6.283*(t+.33)),.5+.5*cos(6.283*(t+.67))); }
half4 main(float2 xy) {
    int EFFECT = Effect + 0;
    float strength=sat(1.0+Amount); float sc=exp2(Scale); half4 src=sampleImage(xy); half3 rgb=straight(src); half3 fx=rgb;
    float2 p=(xy-iResolution*.5)/max(iResolution.y,1.0); float r=length(p),a=atan(p.y,p.x); float l=float(lum(rgb));
    if (EFFECT==0) fx=rgb+ramp(fract(a/6.283+r*2.0+Seed))*half(.35+.25*sin(r*45.0));
    else if (EFFECT==1) { float d=7.0*sc; fx=half3(straight(sampleImage(xy+float2(d,0))).r,rgb.g,straight(sampleImage(xy-float2(d,0))).b); }
    else if (EFFECT==2) fx=mix(half3(.04,.03,.12),half3(1.0,.45,.08),half(l));
    else if (EFFECT==3) fx=rgb+ramp(fract(a/6.283+l))*half(.45*(1.0-r));
    else if (EFFECT==4) { float dust=pow(hash21(floor(xy/(3.0*sc))),16.0); fx=rgb+half3(.55,.3,1.0)*half(dust*2.0); }
    else if (EFFECT==5) { float wind=sat(sin(xy.y*.03+sin(xy.x*.008))*0.5+0.5); fx=rgb+half3(.35,.55,1.0)*half(wind*.35); }
    else if (EFFECT==6) { float k=6.0; float aa=mod(a,6.283/k); aa=abs(aa-3.14159/k); float2 uv=iResolution*.5+float2(cos(aa),sin(aa))*r*iResolution.y; fx=straight(sampleImage(uv)); }
    else if (EFFECT==7) { float bloom=exp(-r*4.0)*(sin(a*9.0+r*35.0)+1.0); fx=rgb+ramp(a/6.283)*half(bloom*.35); }
    else if (EFFECT==8) fx=mix(half3(.04,.12,.28),half3(1.0,.32,.12),half(step(.48,l)));
    else { half3 gx=straight(sampleImage(xy+float2(2,0)))-straight(sampleImage(xy-float2(2,0))); half3 gy=straight(sampleImage(xy+float2(0,2)))-straight(sampleImage(xy-float2(0,2))); float e=sat(length(float2(float(lum(gx)),float(lum(gy))))*4.0); if(EFFECT==9) fx=rgb+half3(.1,.7,1.0)*half(e); else fx=half3(rgb.r+gx.r*.8,rgb.g+gy.g*.35,rgb.b-gx.b*.8); }
    return finish(mix(rgb,fx,half(strength)),src.a);
}
