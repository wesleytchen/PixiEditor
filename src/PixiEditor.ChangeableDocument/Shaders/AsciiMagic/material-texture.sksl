// Material & Texture — selectable ASCII Magic-inspired family for PixiEditor
// Effect is an integer selector. Amount: -1=bypass, 0=default, 1=strong.
uniform shader iImage;
uniform float2 iResolution;
uniform float iNormalizedTime;
uniform int Effect;
uniform float Amount;
uniform float Scale;
uniform float Seed;

float sat(float x) { return clamp(x, 0.0, 1.0); }
float hash21(float2 p) {
    p = fract(p * float2(123.34, 456.21));
    p += dot(p, p + 45.32 + Seed);
    return fract(p.x * p.y);
}
float lum(half3 c) { return dot(c, half3(0.2126, 0.7152, 0.0722)); }
half4 sampleImage(float2 p) { return iImage.eval(p); }
half4 finish(half3 rgb, half a) { return half4(clamp(rgb, half3(0.0), half3(1.0)) * a, a); }
half3 straight(half4 c) { return c.a > 0.0001 ? c.rgb / c.a : half3(0.0); }

// Effect values:
//   0: Waves
//   1: Oil Paint
//   2: Watercolor
//   3: Chrome
//   4: Thin-Film
//   5: Marble
//   6: Molten Metal
//   7: Crystallize
//   8: Emboss
//   9: Petrol Sheen
//   10: Heat Tint
half3 spectral(float t) { return half3(.55+.45*cos(6.283*(t+.0)),.55+.45*cos(6.283*(t+.33)),.55+.45*cos(6.283*(t+.67))); }
half4 main(float2 xy) {
    int EFFECT = Effect + 0;
    float strength=sat(1.0+Amount),sc=exp2(Scale); half4 src=sampleImage(xy); half3 rgb=straight(src); half3 fx=rgb;
    float2 p=xy/(18.0*sc); float n=hash21(floor(p)); float l=float(lum(rgb));
    half3 gx=straight(sampleImage(xy+float2(2,0)))-straight(sampleImage(xy-float2(2,0)));
    half3 gy=straight(sampleImage(xy+float2(0,2)))-straight(sampleImage(xy-float2(0,2)));
    float edge=length(float2(float(lum(gx)),float(lum(gy))));
    if(EFFECT==0) { float w=sin(p.x+sin(p.y*.7))*8.0; fx=rgb*half(.72)+spectral(fract(w*.1+l))*half(.35); }
    else if(EFFECT==1) { float2 uv=xy+float2(sin(p.y*2.0),cos(p.x*1.7))*7.0; fx=(straight(sampleImage(uv))+rgb)*half(.5); fx=floor(fx*half(12.0))/half(12.0); }
    else if(EFFECT==2) { float wash=hash21(floor(xy/(7.0*sc))); fx=mix(half3(.95,.92,.82),rgb,half(.55+.35*wash)); }
    else if(EFFECT==3) { float m=pow(sat(1.0-edge*3.0),3.0); fx=half3(.08)+half3(m*.8)+spectral(l)*half(.18); }
    else if(EFFECT==4) fx=mix(rgb,spectral(fract(l*3.0+sin(p.x+p.y)*.15)),half(.65));
    else if(EFFECT==5) { float vein=abs(sin(p.x+sin(p.y*1.4)+n*.8)); fx=mix(rgb,half3(.92,.89,.83),half(pow(vein,10.0))); }
    else if(EFFECT==6) { float hot=sat(l+edge*2.0); fx=mix(half3(.05,.03,.02),half3(1.0,.45,.06),half(hot))+half3(edge*.5); }
    else if(EFFECT==7) { float2 q=fract(p)-.5; float facets=abs(q.x)+abs(q.y); fx=rgb*half(.55+.7*step(facets,.42))+spectral(n)*half(.18); }
    else if(EFFECT==8) fx=rgb+half3(float(lum(gx))*1.8+float(lum(gy))*.7);
    else if(EFFECT==9) fx=mix(rgb,spectral(fract(l+sin(p.x)*.15+n*.1)),half(.55));
    else fx=mix(rgb,half3(1.0,.18,.02)+spectral(fract(l*1.4))*.35,half(sat(l*.7+edge)));
    return finish(mix(rgb,fx,half(strength)),src.a);
}
